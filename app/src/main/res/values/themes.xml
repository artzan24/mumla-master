<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Mumla" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="pttPressed">@color/md_theme_light_primary_darker</item>
        <!-- Make it so appbar's popupmenu has light theme, even though appbar has dark -->
        <item name="popupOverlay">@style/ThemeOverlay.Material3.Light</item>
        <!-- Make the Chat Target "banner" ActionMode obscure the ActionBar,
        instead of pushing it (and the rest of the layout) down. -->
        <item name="windowActionModeOverlay">true</item>
        <!-- This makes the ActionMode background dark, somehow: that style is empty!
         But it is what we want, on both dark/light themes (text color is bright) -->
        <item name="actionModeStyle">@style/App.Widget.ActionMode</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.App.Toolbar.Title</item>
    </style>

    <!-- Gunakan parent AppCompat agar aman dan tidak error resource not found -->
    <style name="TextAppearance.App.Toolbar.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item> <!-- Ubah sesuai ukuran yang diinginkan, misal 14sp -->
    </style>

    <!-- This is for always have dark themed appbar, used in activity .xmls -->
    <style name="TweakedAppBarLayout" parent="">
        <!-- Set background to primary color of theme -->
        <item name="android:background">?attr/colorPrimary</item>
        <!-- Use dark actionbar theme to ensure text/icons are light -->
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <!-- Tema khusus untuk Splash Screen menggunakan warna gelap dari colors.xml -->
    <style name="Theme.Mumla.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Menggunakan md_theme_dark_primary (#001b2b) -->
        <item name="android:windowBackground">@color/md_theme_dark_primary</item>
    </style>

    <!-- DI EDIT DI SINI: Samakan warna windowBackground dengan warna background utama/toolbar aplikasi Anda -->
    <style name="Theme.Mumla.NoFlash" parent="Theme.Mumla">
        <item name="android:windowBackground">@color/md_theme_dark_primary</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="App.Widget.ActionMode" parent="Widget.AppCompat.ActionMode">
    </style>

    <style name="Theme.Mumla" parent="Base.Theme.Mumla" />
</resources>
