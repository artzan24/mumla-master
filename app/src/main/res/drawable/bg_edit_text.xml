<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar belakang input (misalnya gelap agak transparan atau abu-abu gelap) -->
    <solid android:color="#1F2A30" />

    <!-- Sudut melengkung 3dp -->
    <corners android:radius="6dp" />

    <!-- Garis tepi (border) agak samar -->
    <stroke
        android:width="1dp"
        android:color="#445A64" />

    <!-- Padding internal teks di dalam input -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp" />

</shape>