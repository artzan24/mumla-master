<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ketika EditText sedang DIPILIH / FOKUS (Warna latar berubah lebih terang/berbeda) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- Warna saat fokus (misal putih terang) -->
            <stroke android:width="2dp" android:color="#2196F3" /> <!-- Garis tepi biru penanda fokus -->
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Ketika TIDAK fokus (Warna standar) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E0" /> <!-- Warna normal (abu-abu agak gelap) -->
            <stroke android:width="1dp" android:color="#BDBDBD" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>