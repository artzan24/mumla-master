<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- State saat Ditekan (Pressed) -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pttPressed" />
            <stroke android:width="5dp" android:color="#FF9800" />
        </shape>
    </item>

    <!-- State saat Aktif / Bicara (Activated / Selected) -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pttPressed" />
            <stroke android:width="5dp" android:color="#4CAF50" />
        </shape>
    </item>

    <!-- State Normal (Default) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary" />
            <stroke android:width="5dp" android:color="#FF9800" />
        </shape>
    </item>

</selector>