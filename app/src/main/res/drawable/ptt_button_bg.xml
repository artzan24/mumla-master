<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. State saat Tombol Dinonaktifkan (Enabled = false) / Belum Join -->
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <!-- Warna background dan border dibuat lebih gelap/pudar -->
            <solid android:color="#303030" />
            <stroke android:width="5dp" android:color="#555555" />
        </shape>
    </item>

    <!-- 2. State saat Aktif / Bicara (Selected) -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pttPressed" />
            <stroke android:width="5dp" android:color="#4CAF50" />
        </shape>
    </item>

    <!-- 3. State saat Ditekan (Pressed) -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pttPressed" />
            <stroke android:width="5dp" android:color="#FF9800" />
        </shape>
    </item>

    <!-- 4. State Normal (Default) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorPrimary" />
            <stroke android:width="5dp" android:color="#FF9800" />
        </shape>
    </item>

</selector>