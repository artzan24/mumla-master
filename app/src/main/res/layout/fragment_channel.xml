<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channelcontainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. KONTEN UTAMA (ViewPager, List Channel, Tombol PTT, dll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ViewPager untuk Daftar Channel -->
        <se.lublin.mumla.channel.NonSwipeableViewPager
            android:id="@+id/channel_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
        </se.lublin.mumla.channel.NonSwipeableViewPager>

        <!-- Panel Target Suara (Whisper/Shout) -->
        <LinearLayout
            android:id="@+id/target_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?colorPrimaryDark"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/target_panel_warning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="12dp"
                android:singleLine="true"
                android:text="Shouting to Channel"
                android:textColor="?android:textColorPrimaryInverse"
                android:textSize="12sp"
                android:textStyle="italic" />

            <ImageView
                android:id="@+id/target_panel_cancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="?android:textColorPrimaryInverse"
                app:srcCompat="@drawable/ic_action_delete_dark" />

        </LinearLayout>

        <!-- Tombol Push-To-Talk di Bawah -->
        <LinearLayout
            android:id="@+id/pushtotalk_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/pushtotalk"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/ptt_button_bg"
                app:srcCompat="@drawable/ic_mic"
                android:tint="#FFFFFF"
                android:contentDescription="@string/ptt"
                android:scaleType="fitCenter"
                android:padding="20dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- ========================================== -->
    <!-- 2. PANEL MODAL PERSEGI (SQUARE) DI TENGAH -->
    <!-- ========================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/active_speaker_panel"
        android:layout_width="260dp"
        android:layout_height="190dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:cardBackgroundColor="#CC212121"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeColor="#00E676"
        app:strokeWidth="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 1. TEKS USER BERBICARA (DI ATAS MIC) -->
            <TextView
                android:id="@+id/active_speaker_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 2. ICON MIC DENGAN WARNA HIJAU -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/ic_mic"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_mic"
                app:tint="#00E676" />

            <!-- 3. NAMA CHANNEL (DI BAWAH MIC) -->
            <TextView
                android:id="@+id/active_speaker_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>