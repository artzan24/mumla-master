<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channelcontainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ========================================== -->
    <!-- PANEL INFO: Status User yang Sedang Bicara -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/active_speaker_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorPrimary"
        android:paddingTop="0dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:srcCompat="@drawable/ic_talking"
            android:tint="#F1F5F9" />

        <TextView
            android:id="@+id/active_speaker_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="11sp"
            android:textColor="#F1F5F9"
            android:textStyle="italic"
            android:singleLine="true"
            android:text="Bripka Andi berbicara di LANTAS DPS" />
    </LinearLayout>

    <!-- ViewPager untuk Daftar Channel -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/channel_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    </androidx.viewpager.widget.ViewPager>

    <!-- Panel Target Suara (Whisper/Shout) -->
    <FrameLayout
        android:id="@+id/target_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:background="?colorPrimaryDark">

        <TextView
            android:id="@+id/target_panel_warning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Shouting to Channel"
            android:textSize="6pt"
            android:textColor="?android:textColorPrimaryInverse"
            android:singleLine="true"
            android:gravity="left|center_vertical"
            android:textStyle="italic"
            android:padding="8dp"/>

        <ImageView
            android:id="@+id/target_panel_cancel"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_action_delete_dark"
            android:tint="?android:textColorPrimaryInverse"
            android:layout_gravity="center_vertical|end"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </FrameLayout>

    <!-- Tombol Push-To-Talk di Bawah -->
    <LinearLayout
        android:id="@+id/pushtotalk_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:padding="12dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/pushtotalk"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/ptt_button_bg"
            app:srcCompat="@drawable/ic_mic"
            android:tint="#FFFFFF"
            android:contentDescription="@string/ptt"
            android:scaleType="fitCenter"
            android:padding="20dp" />

    </LinearLayout>

</LinearLayout>