<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channel_row_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:background="@color/channel_bg_selector">

    <!-- Diubah menjadi TextView untuk menampilkan 2 huruf inisial -->
    <TextView
        android:id="@+id/channel_row_expand"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_circle_initial" />

    <!-- Teks Nama Channel & Status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/channel_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:singleLine="true"
            android:text="Channel Name"/>

        <TextView
            android:id="@+id/channel_row_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#546E7A"
            android:layout_marginTop="3dp"
            android:textStyle="italic"
            android:singleLine="true"
            android:text="Only you are connected"/>
    </LinearLayout>

    <!-- Tombol Join / Power -->
    <ImageView
        android:id="@+id/channel_row_join"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        app:srcCompat="@drawable/ic_join"
        android:tint="@color/join_icon_tint"
        android:background="@drawable/bg_join_circle"
        android:padding="8dp" />

    <!-- Tombol Menu Titik Tiga -->
    <ImageView
        android:id="@+id/channel_row_more"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingLeft="8dp"
        android:tint="#B0BEC5"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_more_vert_black_24dp" />
</LinearLayout>