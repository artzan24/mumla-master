<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/md_theme_dark_primary">

    <!-- Menggunakan layout_gravity="center" dan gravity="center" agar tepat di tengah layar (vertikal & horizontal) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Kartu Bingkai Utama -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardUseCompatPadding="false"
            style="?cardStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/md_theme_dark_primary"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Logo Aplikasi -->
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/tik_polri" />

                <!-- Nama Instansi / Judul Aplikasi -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="BID TIK POLDA BALI"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Deskripsi Singkat -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Silahkan Pilih Daftar Server"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <!-- Header Saved Servers & Tombol Add Server -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="DAFTAR SERVER"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/menu_add_server_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="+ Add Server"
                        android:textColor="#ff2079ab"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- GridView untuk List Server -->
                <GridView
                    android:id="@+id/server_list_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:numColumns="1"
                    android:horizontalSpacing="0dp"
                    android:verticalSpacing="2dp"
                    android:scrollbars="none" />

                <!-- Tampilan Kosong (Empty View) -->
                <TextView
                    android:id="@+id/server_list_grid_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="No servers added yet"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Tautan Tambahan di Bawah -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Aplikasi Mumble yang dikembangkan oleh Tim Teknis BID TIK Polda Bali"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>