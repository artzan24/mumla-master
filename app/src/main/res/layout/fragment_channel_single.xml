<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:windowBackground">

    <!-- Toolbar Atas (Hanya untuk Judul & Tombol Back) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_single"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?colorPrimary"
        android:elevation="4dp"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Header Informasi Channel dengan Tombol Gabung di Sebelah Kanan Nama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingStart="60dp"
        android:paddingEnd="16dp"
        android:background="?colorPrimary">

        <!-- Info Channel (Nama & Status) di Kiri -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/single_channel_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deskripsi Channel"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/single_channel_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Belum Terhubung"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="italic"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tv_channel_busy_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Channel: Idle"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:gravity="center_vertical"
                android:drawablePadding="11dp"
                android:layout_marginTop="4dp"
                android:textStyle="italic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_talking_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#FFB74D"
                android:gravity="center_vertical"
                android:drawablePadding="10dp"
                android:visibility="gone"
                android:textStyle="italic"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Konten Utama / List User -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    </FrameLayout>

    <!-- Panel Active Speaker -->
    <LinearLayout
        android:id="@+id/active_speaker_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone"
        android:background="#333333">

        <TextView
            android:id="@+id/active_speaker_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:text="Seseorang sedang berbicara..." />
    </LinearLayout>

    <!-- Tombol PTT -->
    <LinearLayout
        android:id="@+id/pushtotalk_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:padding="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/pushtotalk"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/ptt_button_bg"
            app:srcCompat="@drawable/ic_mic"
            android:contentDescription="@string/ptt"
            android:scaleType="fitCenter"
            android:padding="20dp"
            app:tint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>