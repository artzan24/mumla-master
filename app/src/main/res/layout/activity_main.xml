<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TweakedAppBarLayout">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:popupTheme="?attr/popupOverlay"
                app:title="@string/app_name">

                <ImageButton
                    android:id="@+id/btn_toolbar_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/bg_back_selector"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_back"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:visibility="gone" />

                <!-- SEARCH VIEW TERSEMBUNYI (Akan muncul di toolbar saat tombol search diklik) -->
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/search_view_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone"
                    app:iconifiedByDefault="false"
                    android:inputType="text"
                    android:textSize="20sp"
                    app:queryHint="Telusuri..." />

                <!-- WADAH TOMBOL KUSTOM UNTUK KEYPAD FISIK DI KANAN TOOLBAR -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:focusable="false"
                    android:descendantFocusability="beforeDescendants">

                    <!-- Tombol Search Kustom -->
                    <ImageButton
                        android:id="@+id/btn_toolbar_search"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_back_selector"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_action_search"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:nextFocusRight="@id/btn_toolbar_settings" />

                    <!-- Tombol Settings -->
                    <ImageButton
                        android:id="@+id/btn_toolbar_settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_back_selector"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_settings"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/btn_toolbar_search"
                        android:nextFocusRight="@id/btn_toolbar_overflow"/>

                    <ImageButton
                        android:id="@+id/btn_toolbar_overflow"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_back_selector"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_options"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:nextFocusDown="@+id/channel_row_title"
                        android:nextFocusLeft="@id/btn_toolbar_settings" />

                </LinearLayout>

            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </LinearLayout>

    <ListView
        android:id="@+id/left_drawer"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?colorPrimaryDark"
        android:choiceMode="singleChoice"
        android:focusable="true"
        android:fitsSystemWindows="true" />

</androidx.drawerlayout.widget.DrawerLayout>