<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_primary"
    android:fitsSystemWindows="false"
    android:paddingEnd="20dp"
    android:paddingStart="20dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- 1. BAGIAN TENGAH: Logo dan Judul Utama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:alpha="0"
            android:contentDescription="Logo"
            android:src="@drawable/tik_polri" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:text="APLIKASI ROIP"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:letterSpacing="0.1"
            android:text="BID TIK POLDA BALI"
            android:textColor="#AAAAAA"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- 2. BAGIAN BAWAH: Loader, Slogan, dan Footer -->
    <LinearLayout
        android:id="@+id/layout_loader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:alpha="0"
        android:gravity="center"
        android:layout_marginTop="30dp"
        android:orientation="vertical">

        <!-- Indikator Loading -->
        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@android:color/white" />

        <!-- Pesan Status -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#DDDDDD"
            android:textSize="13sp" />

        <!-- Slogan Baris Pertama -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Mengabdi dengan Integrasi Melayani dengan Teknologi"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>

</RelativeLayout>