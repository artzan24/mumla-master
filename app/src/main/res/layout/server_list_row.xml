<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="0dp"
    app:cardCornerRadius="0dp"
    app:cardBackgroundColor="@color/md_theme_dark_primary"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:background="@color/md_theme_dark_primary">

        <!-- Label Username / NRP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username atau NRP"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <!-- Input Username (Background Putih, Teks Hitam, Tanpa Border) -->
        <EditText
            android:id="@+id/server_row_edit_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_edit_text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:id="@+id/tv_error_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp" />

        <!-- Label Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <!-- Wadah Input Password & Toggle Mata (Background Putih, Tanpa Border) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_edit_text"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/server_row_edit_password"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="text"
                android:fontFamily="sans-serif"
                android:textColor="#000000"
                android:textColorHint="#757575"
                android:textSize="12sp"
                android:padding="0dp" />

            <ImageView
                android:id="@+id/btn_row_toggle_password"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="6dp"
                android:paddingStart="6dp"
                android:src="@drawable/ic_visibility"
                app:tint="#757575" />
        </LinearLayout>

        <!-- Tombol Connect Langsung -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_row_connect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CONNECT"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#2196F3"
            app:cornerRadius="8dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>